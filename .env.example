# Sentra AI Testing Engine - Environment Variables

# Required: Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini 3.5 Flash model
# GEMINI_MODEL=gemini-3.5-flash

# Optional: OpenRouter API Key (for alternative models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: AWS credentials (for Bedrock, if needed)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
